SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
# Local HTTP only. Always true in production (Vercel).
COOKIE_SECURE=false
# Comma-separated production origins, e.g. https://gs-pay.vercel.app
ALLOWED_ORIGINS=
# Set true only when you need /docs locally
ENABLE_DOCS=false
# Optional amount caps (won)
# MAX_CHARGE_AMOUNT=100000
# MAX_BALANCE=500000
# MAX_MENU_PRICE=100000
